# 复制为 .env 并修改
# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=invoice_system

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 登录安全：连续错误 N 次锁定 M 分钟
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- 账号生命周期（真实使用场景）----
# 密码强度：至少 N 位且同时含字母与数字。注册 / 自助重置 / 管理员建号与重置共用这一条口径。
PASSWORD_MIN_LENGTH=8

# 首次启动引导管理员：留空则生成一次性随机密码并打印到后端控制台（推荐）
# 也可以在这里固定一个初始密码（同样要满足上面的强度要求）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员

# 自助注册默认进入的部门。**不允许注册者自选部门** —— 部门决定预算上限，自选等于自己改预算。
# 上限刻意很小，但**不能是 0**：预审写的是 `if monthly_limit:`，0 会被当成「没设上限」。
DEFAULT_DEPT_NAME=待分配
DEFAULT_DEPT_SINGLE_LIMIT=100
DEFAULT_DEPT_MONTHLY_LIMIT=500

# 忘记密码：重置令牌有效期（令牌只存哈希、单次有效、用过即废）
RESET_TOKEN_EXPIRE_MINUTES=30
# 是否把重置链接打印到后端控制台。**仅供本地演示/排障，生产必须 false**
RESET_TOKEN_ECHO=false

# 公开接口限流（内存计数，单进程有效；多实例部署需换 Redis）
# 注册只按 IP 且刻意宽松：公司出口 NAT 下几十人共用一个 IP，卡太死会误伤正常注册
REGISTER_RATE_LIMIT_PER_MINUTE=30
FORGOT_RATE_LIMIT_PER_MINUTE=10
# 忘记密码再按账号收紧：防止拿同一个邮箱反复轰炸对方
FORGOT_ACCOUNT_RATE_LIMIT_PER_MINUTE=3
RESET_RATE_LIMIT_PER_MINUTE=10

# 邮件（忘记密码发重置链接）。SMTP_HOST 留空时自动降级为
# 「提交重置申请 → 管理员在用户管理里一键重置」，离线/内网也能走通。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=
SMTP_FROM_NAME=智能发票报销审核系统
# 邮件里重置链接的前端地址
FRONTEND_BASE_URL=http://localhost:5173

# AI 服务切换（mock | paddle / mock | deepseek | qwen | glm | openai）
# 切真实 OCR：把 OCR_PROVIDER 改成 paddle（需先 pip install -r requirements.txt）
OCR_PROVIDER=mock
# 切真实 LLM：改成 deepseek / qwen / glm / openai 并填下面的 LLM_API_KEY
# mock 是确定性输出（不改单据、不联网），自动化验收与本地联调都用它
LLM_PROVIDER=mock

# ---- 财务审核 AI 助手（云 LLM）----
# 各家都走 OpenAI 兼容协议，只是接入点与默认模型不同：
#   deepseek → https://api.deepseek.com            （deepseek-flash；国内可直连）
#   qwen     → https://dashscope.aliyuncs.com/compatible-mode/v1 （qwen-plus）
#   glm      → https://open.bigmodel.cn/api/paas/v4             （glm-4-flash）
#   openai   → https://api.openai.com/v1                         （gpt-4o-mini，国内直连通常不通）
LLM_API_KEY=
# 留空＝用上面的默认接入点/默认模型；填了则覆盖（可指向自建网关或中转）
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
# JSON Output 模式下部分实现有概率返回空 content（DeepSeek 官方文档有说明），
# 拿不到可解析 JSON 时额外重试几次；0 表示不重试
LLM_JSON_RETRY=1
# 数据最小化：为 true 时把「销售方名称」脱敏成「销售方A/B…」，拿到模型输出后在服务端还原真名。
# 无论开关如何，**购买方名称/税号、发票代码/号码、发票影像都不会外发**（语义分析用不到，
# 见 app/services/agent/facts.py）。但「报销事由」是申请人写的自由文本，必须原样外发才能做
# 事由一致性判断 —— 这是本方案残留的隐私风险，需业务方确认接受。
LLM_MASK_PII=true

# PaddleOCR（OCR_PROVIDER=paddle 时生效）：本地 CPU 推理，发票影像与结果都不出本机
PADDLE_OCR_LANG=ch
PADDLE_OCR_USE_GPU=false
# 关闭 ppocr 的 DEBUG 日志（改 true 可看每次识别的详细参数与进度）
PADDLE_OCR_SHOW_LOG=false
# 离线部署用：留空＝首次识别自动联网下载模型到 ~/.paddleocr；填目录＝直接用现成模型
PADDLE_OCR_DET_MODEL_DIR=
PADDLE_OCR_REC_MODEL_DIR=
PADDLE_OCR_CLS_MODEL_DIR=

# CORS 来源（逗号分隔；开发期走 vite proxy 则无需放开）
CORS_ORIGINS=http://localhost:5173

# 抬头核验（公司主体，需求 4.4 待确认输入）
COMPANY_NAME=示例科技有限公司
COMPANY_TAX_NO=91330100MA2XXXXXXX

# 规则参数
OCR_CONFIDENCE_THRESHOLD=0.85
AMOUNT_TOLERANCE=0.01
BUDGET_WARN_RATIO=0.8
# 抬头核验（发票购买方名称/税号 vs 公司主体）开关
# 注意：COMPANY_NAME / COMPANY_TAX_NO 还是占位值时，开着会让所有真实发票都命中预警，
# 建议先设 false；填入真实公司主体后再改 true
PREAUDIT_BUYER_CHECK=true

# 上传限制
MAX_UPLOAD_MB=10
# 影像落盘目录。⚠️ 这个目录**不随数据库隔离** —— 跑验收脚本（e2e_check / demo_flow /
# check_auth）时如果还用默认值，测试图会直接灌进生产上传目录（清出一堆没人引用的孤儿文件）。
# 所以拿测试库跑验收时，顺手把这里也换掉：
#   DB_NAME=invoice_system_e2e  UPLOAD_DIR=storage/uploads_e2e
UPLOAD_DIR=storage/uploads

# PDF 发票：上传的 PDF 会先拆成逐页 PNG 再识别
# 渲染倍数 2.0 ≈ 144dpi；MAX_PDF_PAGES 是单份 PDF 的页数上限（OCR 同步执行，页数越多越慢）
PDF_RENDER_SCALE=2.0
MAX_PDF_PAGES=20

# Cookie 名（一般不用改；Access/Refresh 为 HttpOnly，CSRF 需前端可读）
ACCESS_COOKIE=access_token
REFRESH_COOKIE=refresh_token
CSRF_COOKIE=csrf_token
