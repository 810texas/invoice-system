# 生产部署示例（nginx 反代 + 静态托管）
#
# 这套配置解决两件事：
#   1. 托管 `npm run build` 产出的 dist/（SPA 需要 fallback 到 index.html，否则刷新子路由 404）
#   2. 把 /api 反代到后端，使前端与接口同源 —— 这样 HttpOnly Cookie、CSRF 双提交、
#      以及 SameSite=Lax 都能按预期工作，前端也不需要配 VITE_API_BASE 或 CORS。
#
# 用法：把 dist/ 上传到 /var/www/invoice-frontend，后端跑在 127.0.0.1:8000，然后
#   nginx -t && nginx -s reload
#
# 注意：正式部署前请务必更换 backend/.env 里的 JWT_SECRET 与演示账号密码，
#       并给 Cookie 加上 secure（见 backend/app/api/v1/auth.py 的 COOKIE_COMMON）。

server {
    listen       80;
    server_name  invoice.example.com;

    # 上传的发票影像可能到 10MB，留出余量
    client_max_body_size 20m;

    # 前端静态产物
    root  /var/www/invoice-frontend;
    index index.html;

    # 带 hash 的静态资源可以长缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 路由回退：/my-reimbursements、/review/todos 等交给前端路由处理
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 接口反代（同源，Cookie 与 CSRF 无需额外配置）
    location /api/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # 多页 PDF 是逐页串行 OCR，同步执行时可能超过默认 60s，这里放宽
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # 接口文档（生产建议关闭或加访问控制）
    location /docs {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
}
